<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/appBar"
        layout="@layout/app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search stays pinned so the list scrolls under it. -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchInput"
            style="@style/Widget.FitTrack.Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/touch_target"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="0dp"
            android:gravity="center_vertical"
            android:hint="@string/community_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="15sp"
            android:importantForAutofill="no"
            android:drawablePadding="@dimen/space_sm"
            app:drawableStartCompat="@drawable/ic_search" />

        <ImageView
            android:id="@+id/createBtn"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_sm"
            android:padding="12dp"
            android:src="@drawable/ic_plus"
            android:background="@drawable/bg_icon_button_brand"
            android:contentDescription="@string/cd_create_community"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/communityList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/content_bottom_padding"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_community" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/brand_bright"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/communityList"
        app:layout_constraintBottom_toBottomOf="@id/communityList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown instead of the list when there is no account, or no network. -->
    <LinearLayout
        android:id="@+id/messageState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_xxl"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/communityList"
        app:layout_constraintBottom_toBottomOf="@id/communityList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/community_signed_out"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

        <TextView
            android:id="@+id/messageAction"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:paddingHorizontal="@dimen/space_xl"
            android:text="@string/action_retry" />

    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- Greeting header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/dashboard_overline"
                android:textAppearance="@style/TextAppearance.FitTrack.Overline"
                android:textColor="@color/brand_bright" />

            <TextView
                android:id="@+id/dashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/dashboard_title"
                android:textAppearance="@style/TextAppearance.FitTrack.Title" />

            <!-- Step ring card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingVertical="@dimen/space_xl"
                android:paddingHorizontal="@dimen/space_lg">

                <FrameLayout
                    android:id="@+id/ringContainer"
                    android:layout_width="@dimen/ring_size"
                    android:layout_height="@dimen/ring_size">

                    <com.example.fittrack.ui.dashboard.StepProgressRingView
                        android:id="@+id/stepRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/stepCountBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/steps_placeholder"
                            android:textAppearance="@style/TextAppearance.FitTrack.Display" />

                        <TextView
                            android:id="@+id/stepGoalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/goal_placeholder"
                            android:textAppearance="@style/TextAppearance.FitTrack.Caption"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="@dimen/space_sm"
                            android:paddingVertical="@dimen/space_xs"
                            android:focusable="true"
                            android:clickable="true" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/onTrackPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/on_track"
                    android:textAppearance="@style/TextAppearance.FitTrack.Overline"
                    android:textColor="@color/brand_bright"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingVertical="10dp" />

                <!-- Explicit affordance for the goal dialog, which used to be
                     reachable only by tapping the small goal label. -->
                <TextView
                    android:id="@+id/editGoalBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/edit_goal"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_bright"
                    app:drawableStartCompat="@drawable/ic_edit"
                    android:drawablePadding="@dimen/space_sm"
                    android:paddingHorizontal="@dimen/space_md"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickAssistantBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_clickable"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_lg"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_circle"
                    android:textSize="20sp"
                    android:text="@string/chat_empty_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_assistant"
                        android:textAppearance="@style/TextAppearance.FitTrack.Section"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/dashboard_assistant_subtitle"
                        android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <!-- Account -->
            <LinearLayout
                android:id="@+id/accountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_clickable"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_md"
                android:focusable="true"
                android:clickable="true">

                <!-- Tapping either the picture or the placeholder opens the
                     photo picker; the ImageView sits on top once one is set. -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true">

                    <TextView
                        android:id="@+id/avatarPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_circle"
                        android:text="@string/account_icon"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_profile_picture" />

                </FrameLayout>

                <TextView
                    android:id="@+id/accountLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/auth_sign_out"
                    android:textAppearance="@style/TextAppearance.FitTrack.Section"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/signOutBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill"
                    android:text="@string/auth_sign_out"
                    android:textColor="@color/brand_bright"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:clickable="true" />

            </LinearLayout>

            <!-- Quick actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/quick_actions"
                android:textAppearance="@style/TextAppearance.FitTrack.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/quickLogBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:background="@drawable/bg_card_clickable"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_icon_circle"
                        android:src="@drawable/ic_nav_log"
                        app:tint="@color/brand_bright"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/quick_log_title"
                        android:textAppearance="@style/TextAppearance.FitTrack.Section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/quick_log_subtitle"
                        android:textAppearance="@style/TextAppearance.FitTrack.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quickChartsBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:background="@drawable/bg_card_clickable"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_icon_circle"
                        android:src="@drawable/ic_nav_charts"
                        app:tint="@color/brand_bright"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/quick_charts_title"
                        android:textAppearance="@style/TextAppearance.FitTrack.Section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/quick_charts_subtitle"
                        android:textAppearance="@style/TextAppearance.FitTrack.Caption" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

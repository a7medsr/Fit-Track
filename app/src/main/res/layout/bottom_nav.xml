<?xml version="1.0" encoding="utf-8"?>
<!--
  Five-tab bottom bar. Every tab is a container so it can hold an icon plus a
  label; NavBarHelper looks the containers up by id and tints their children.
  "Log" is styled as a raised badge because it is the primary action.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:orientation="horizontal"
    android:background="@drawable/bg_nav_bar"
    android:elevation="12dp">

    <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/navHomeIcon"
                style="@style/NavItemIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_home"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/navHomeLabel"
            style="@style/NavItemLabel"
            android:text="@string/nav_home" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navHistory" style="@style/NavItem">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/navHistoryIcon"
                style="@style/NavItemIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_history"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/navHistoryLabel"
            style="@style/NavItemLabel"
            android:text="@string/nav_history" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navLog" style="@style/NavItem">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nav_log_badge">
            <ImageView
                android:id="@+id/navLogIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_log"
                app:tint="@color/on_brand"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/navLogLabel"
            style="@style/NavItemLabel"
            android:text="@string/nav_log" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navCharts" style="@style/NavItem">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/navChartsIcon"
                style="@style/NavItemIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_charts"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/navChartsLabel"
            style="@style/NavItemLabel"
            android:text="@string/nav_charts" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navRecords" style="@style/NavItem">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/navRecordsIcon"
                style="@style/NavItemIcon"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_records"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/navRecordsLabel"
            style="@style/NavItemLabel"
            android:text="@string/nav_records" />
    </LinearLayout>

</LinearLayout>

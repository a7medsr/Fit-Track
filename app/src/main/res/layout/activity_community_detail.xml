<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/space_sm"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/screenTitle"
            style="@style/Widget.FitTrack.AppBarTitle"
            android:layout_gravity="center"
            android:layout_marginHorizontal="64dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Morning Runners" />

        <TextView
            android:id="@+id/manageBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_md"
            android:text="@string/community_action_manage"
            android:textColor="@color/brand_bright"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true" />

    </FrameLayout>

    <!-- Two tabs rather than a ViewPager: each side loads separately and only
         when looked at, which keeps a leaderboard query off the critical path
         of simply reading the feed. -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/feedTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/community_tab_feed"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_chip_selected"
            android:textColor="@color/brand_bright"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/boardTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/community_tab_board"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_chip_unselected"
            android:textColor="@color/text_secondary"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <!-- Only on the leaderboard: which week, what it counts, and who won the
         one before. -->
    <LinearLayout
        android:id="@+id/boardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:background="@drawable/bg_card_hero"
        android:padding="@dimen/space_lg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/boardWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FitTrack.Overline"
            tools:text="25 Aug – 31 Aug · Steps" />

        <TextView
            android:id="@+id/lastWeekWinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption"
            android:visibility="gone"
            tools:text="Last week: Ahmed Samir, 68,402 steps"
            tools:visibility="visible" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/content_bottom_padding"
        app:layout_constraintTop_toBottomOf="@id/boardHeader"
        app:layout_constraintBottom_toTopOf="@id/newPostBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_post" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/brand_bright"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/contentList"
        app:layout_constraintBottom_toBottomOf="@id/contentList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_xxl"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/contentList"
        app:layout_constraintBottom_toBottomOf="@id/contentList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="No posts yet. Be the first."
        tools:visibility="visible" />

    <TextView
        android:id="@+id/newPostBtn"
        style="@style/Widget.FitTrack.Button.Primary"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_lg"
        android:text="@string/community_action_new_post"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

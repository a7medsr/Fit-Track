<?xml version="1.0" encoding="utf-8"?>
<!-- Label plus context on the left, the record itself on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/space_md">

    <TextView
        android:id="@+id/recordIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:background="@drawable/bg_icon_circle"
        android:textSize="17sp"
        android:text="@string/em_dash" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_md">

        <TextView
            android:id="@+id/recordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/em_dash"
            android:textAppearance="@style/TextAppearance.FitTrack.Section"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/recordCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/em_dash"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/recordValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/em_dash"
        android:textAppearance="@style/TextAppearance.FitTrack.Section"
        android:textSize="16sp"
        android:textColor="@color/brand_bright" />

</LinearLayout>

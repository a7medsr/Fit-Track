<?xml version="1.0" encoding="utf-8"?>
<!--
  Walking is derived from the step counter rather than logged by hand, so this
  card is tinted green to set it apart from the manual activity cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:orientation="vertical"
    android:background="@drawable/bg_card_accent"
    android:padding="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle"
            android:textSize="22sp"
            android:text="@string/walking_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/walking"
                android:textAppearance="@style/TextAppearance.FitTrack.Section"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/autoWalkSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/steps_today_placeholder"
                android:textAppearance="@style/TextAppearance.FitTrack.Caption" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto"
            android:textAppearance="@style/TextAppearance.FitTrack.Overline"
            android:textColor="@color/brand_bright"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/autoWalkCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/calories_estimate_zero"
        android:textAppearance="@style/TextAppearance.FitTrack.Metric"
        android:textSize="24sp"
        android:textColor="@color/brand_bright" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/tracked_automatically"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption"
        android:textSize="12sp" />

</LinearLayout>

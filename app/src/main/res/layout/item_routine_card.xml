<?xml version="1.0" encoding="utf-8"?>
<!--
  A saved session on the Log screen. Tapping the body opens the editor; the
  green play button logs every exercise in the session at once.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_lg">

    <LinearLayout
        android:id="@+id/routineBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true">

        <TextView
            android:id="@+id/routineIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle"
            android:textSize="22sp"
            android:text="@string/routine_default_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_md">

            <TextView
                android:id="@+id/routineName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/routine_name_placeholder"
                android:textAppearance="@style/TextAppearance.FitTrack.Section"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/routineMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/routine_meta_placeholder"
                android:textAppearance="@style/TextAppearance.FitTrack.Caption"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/routineLoggedToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_bright"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="6dp"
                android:visibility="gone"
                android:text="" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/routinePlayBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_md"
        android:gravity="center"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:background="@drawable/bg_button_primary"
        android:text="@string/routine_log_now"
        android:textColor="@color/on_brand"
        android:textSize="14sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>

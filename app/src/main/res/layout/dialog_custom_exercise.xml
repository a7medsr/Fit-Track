<?xml version="1.0" encoding="utf-8"?>
<!--
  Create / edit a custom exercise. The same layout serves both: in edit mode the
  title changes and the delete button becomes visible.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_card"
        android:padding="@dimen/space_xl">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custom_exercise_title"
            android:textAppearance="@style/TextAppearance.FitTrack.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/custom_exercise_subtitle"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/custom_exercise_name_label"
            android:textAppearance="@style/TextAppearance.FitTrack.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/exerciseIconInput"
                style="@style/Widget.FitTrack.Input"
                android:layout_width="64dp"
                android:layout_height="@dimen/button_height"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/custom_exercise_default_icon"
                android:maxLength="4"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="text"
                android:textSize="22sp"
                android:importantForAutofill="no"
                android:contentDescription="@string/cd_exercise_emoji" />

            <EditText
                android:id="@+id/exerciseNameInput"
                style="@style/Widget.FitTrack.Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="0dp"
                android:gravity="center_vertical"
                android:hint="@string/custom_exercise_name_hint"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="15sp"
                android:importantForAutofill="no" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/custom_exercise_category_label"
            android:textAppearance="@style/TextAppearance.FitTrack.Overline" />

        <LinearLayout
            android:id="@+id/categoryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/custom_exercise_intensity_label"
            android:textAppearance="@style/TextAppearance.FitTrack.Overline" />

        <LinearLayout
            android:id="@+id/intensityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/intensityHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/custom_exercise_intensity_hint"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/deleteExerciseBtn"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/custom_exercise_delete"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_lg">

            <TextView
                android:id="@+id/cancelBtn"
                style="@style/Widget.FitTrack.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/action_cancel"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/saveBtn"
                style="@style/Widget.FitTrack.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/custom_exercise_save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

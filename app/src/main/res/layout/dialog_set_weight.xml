<?xml version="1.0" encoding="utf-8"?>
<!-- Body weight feeds the MET calorie formula, so it lives next to the log. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="@dimen/space_xl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weight_dialog_title"
        android:textAppearance="@style/TextAppearance.FitTrack.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/weight_dialog_subtitle"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_xl">

        <TextView
            android:id="@+id/weightMinus"
            style="@style/Widget.FitTrack.Stepper"
            android:text="@string/duration_minus"
            android:contentDescription="@string/cd_decrease_weight" />

        <EditText
            android:id="@+id/weightInput"
            style="@style/Widget.FitTrack.Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/touch_target"
            android:layout_marginHorizontal="@dimen/space_sm"
            android:padding="0dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="3"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="20sp"
            android:importantForAutofill="no"
            android:hint="@string/weight_hint" />

        <TextView
            android:id="@+id/weightPlus"
            style="@style/Widget.FitTrack.Stepper"
            android:text="@string/duration_plus"
            android:contentDescription="@string/cd_increase_weight" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_xl">

        <TextView
            android:id="@+id/cancelBtn"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_cancel"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/saveBtn"
            style="@style/Widget.FitTrack.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/weight_save" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_detail_row"
    android:padding="@dimen/space_md"
    android:layout_marginTop="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/detailIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="@string/em_dash" />

        <TextView
            android:id="@+id/detailType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/activity_placeholder"
            android:textAppearance="@style/TextAppearance.FitTrack.Section"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_stats_placeholder"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/deleteBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_md"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_delete_button"
            android:contentDescription="@string/cd_delete_activity"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/detailNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone" />

</LinearLayout>

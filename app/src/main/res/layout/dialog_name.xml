<?xml version="1.0" encoding="utf-8"?>
<!-- Asks an existing account for a name before it appears in a community.
     Accounts created before the sign-up form collected one have none, and the
     alternative is publishing their email address or calling them "Member". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="@dimen/space_xl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/community_name_prompt_title"
        android:textAppearance="@style/TextAppearance.FitTrack.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/community_name_prompt_body"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

    <EditText
        android:id="@+id/firstNameInput"
        style="@style/Widget.FitTrack.Input"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_xl"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="0dp"
        android:gravity="center_vertical"
        android:hint="@string/auth_first_name_hint"
        android:inputType="textPersonName|textCapWords"
        android:autofillHints="personGivenName"
        android:maxLength="30"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/lastNameInput"
        style="@style/Widget.FitTrack.Input"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_md"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="0dp"
        android:gravity="center_vertical"
        android:hint="@string/auth_last_name_hint"
        android:inputType="textPersonName|textCapWords"
        android:autofillHints="personFamilyName"
        android:maxLength="30"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/nameError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption"
        android:textColor="@color/danger"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelBtn"
            style="@style/Widget.FitTrack.Button.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/saveBtn"
            style="@style/Widget.FitTrack.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/community_name_prompt_save" />

    </LinearLayout>

</LinearLayout>

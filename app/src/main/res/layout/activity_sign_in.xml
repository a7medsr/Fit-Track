<?xml version="1.0" encoding="utf-8"?>
<!--
  Google is the only way in. There is no password field because there is no
  password: the account is whatever Google says it is, which is also what makes
  the email address on a community post a verified one rather than something
  anybody could type.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:minHeight="600dp"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingVertical="@dimen/space_xxl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/brand_bright" />

            <TextView
                android:id="@+id/authTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/auth_title_google"
                android:textAppearance="@style/TextAppearance.FitTrack.Title" />

            <TextView
                android:id="@+id/authSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/auth_subtitle_google"
                android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

            <TextView
                android:id="@+id/authMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:textAppearance="@style/TextAppearance.FitTrack.Caption"
                android:visibility="gone"
                tools:text="No Google account available on this device."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/googleBtn"
                style="@style/Widget.FitTrack.Button.Primary"
                android:layout_marginTop="@dimen/space_xxl"
                android:text="@string/auth_action_google" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/auth_google_explainer"
                android:textAppearance="@style/TextAppearance.FitTrack.Caption"
                android:textColor="@color/text_tertiary" />

            <!-- The app is offline-first, so an account has never been required.
                 Skipping keeps everything working locally; signing in later
                 adopts that data. Communities are the one part that needs an
                 account, because everything in them is attributed. -->
            <TextView
                android:id="@+id/skipBtn"
                style="@style/Widget.FitTrack.Button.Secondary"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/auth_skip" />

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/authProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/brand_bright"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

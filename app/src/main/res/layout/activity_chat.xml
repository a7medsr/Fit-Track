<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/appBar"
        layout="@layout/app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Not a doctor. Stated once, permanently, rather than in every reply. -->
    <TextView
        android:id="@+id/disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/chat_disclaimer"
        android:textAppearance="@style/TextAppearance.FitTrack.Caption"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_md"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/disclaimer"
        app:layout_constraintBottom_toTopOf="@id/composer" />

    <!-- Loading / Empty / Error share this block; only the copy changes. -->
    <LinearLayout
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_xxl"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/disclaimer"
        app:layout_constraintBottom_toTopOf="@id/composer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_empty_icon"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/stateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/chat_empty_title"
            android:textAppearance="@style/TextAppearance.FitTrack.Section" />

        <TextView
            android:id="@+id/stateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/chat_empty_body"
            android:textAppearance="@style/TextAppearance.FitTrack.Caption" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <EditText
            android:id="@+id/messageInput"
            style="@style/Widget.FitTrack.Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:maxHeight="120dp"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_md"
            android:gravity="center_vertical"
            android:hint="@string/chat_input_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:importantForAutofill="no"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/sendBtn"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_sm"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_icon_button_brand"
            android:contentDescription="@string/chat_send"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

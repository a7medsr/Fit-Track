# Port the service listens on. nginx proxies to this; it is never exposed directly.
PORT=3001

# Where the image files live. Deliberately OUTSIDE any web docroot.
AVATAR_DIR=/var/lib/fittrack/avatars

# Public base for generated URLs, must match the nginx server_name.
PUBLIC_BASE_URL=https://fittrack.tecisfun.cloud

# Firebase service account JSON, downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=/etc/fittrack/firebase-service-account.json
